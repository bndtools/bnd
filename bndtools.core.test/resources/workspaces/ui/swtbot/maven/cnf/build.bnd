# Test workspace for the Maven repository context menu SWTBot tests.
# Both repositories download their artifact from Maven Central on first use.
# The "strict" repository trusts exactly one checksum and has none for the
# -sources jar, like a repository whose checksum file was generated by
# "Create Trusted Checksums file".

-plugin.0.MavenFixture:\
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        name = "Maven Fixture";\
        releaseUrl = "https://repo.maven.apache.org/maven2/";\
        index = "${.}/maven-fixture.maven";\
        local = "${.}/cache/maven-fixture"

-plugin.1.MavenStrictFixture:\
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        name = "Maven Strict Fixture";\
        releaseUrl = "https://repo.maven.apache.org/maven2/";\
        index = "${.}/maven-strict.maven";\
        checksumFile = "${.}/maven-strict.checksums";\
        checksumPolicy = strict;\
        local = "${.}/cache/maven-strict"
